# 이 파일을 .env로 복사해서 채운다. .env는 절대 커밋하지 않는다.

# Anthropic API 키 (서버 전용 — 클라이언트/번들에 노출 금지)
# 없으면 엔진은 자동으로 mock LLM으로 돌아간다(테스트·오프라인 데모용).
ANTHROPIC_API_KEY=
# 키가 워크스페이스에 묶여 있지 않으면 필요 (콘솔 Settings → Workspaces의 ID, wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=

# 설명 카드·챗봇 생성 모델
ROOKIE_LLM_MODEL=claude-sonnet-5

# 방금 장면 한 줄 요약 모델 (짧고 많아서 저비용 모델)
ROOKIE_SUMMARY_MODEL=claude-haiku-4-5

# LLM 어댑터 강제 선택: auto(기본) | claude | mock | fail
#   auto  — 키가 있으면 claude, 없으면 mock
#   fail  — 항상 실패시켜 폴백 경로를 검증할 때 사용
ROOKIE_LLM_BACKEND=auto

# 영상 분석(scripts/analyze_video.py) — NVIDIA 호스팅 Cosmos Reason(VSS 기본 VLM) 키.
# build.nvidia.com에서 발급. 트라이얼 약관상 사전 배치 분석에만 쓴다(서버 런타임은 호출 안 함).
# NVIDIA_API_KEY=
# VSS LVS 서버를 쓸 때 인증 토큰(있으면)
# VSS_API_TOKEN=

# 실시간 모드: 분석기(scripts/live_video.py)가 서버에 결과를 보낼 때 쓰는 토큰. 비우면 수집 꺼짐.
# ROOKIE_LIVE_TOKEN=

# CORS 허용 오리진 (쉼표 구분). 배포 시 프론트 도메인으로 바꾼다.
# ROOKIE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 데이터 경로 (보통 건드릴 일 없음)
# ROOKIE_FIXTURE_DIR=./data/fixtures
# ROOKIE_SNAPSHOT_DIR=./data/snapshots
