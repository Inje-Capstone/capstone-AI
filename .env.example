# 이 파일을 .env로 복사해서 채운다. .env는 절대 커밋하지 않는다.

# Anthropic API 키 (서버 전용 — 클라이언트/번들에 노출 금지)
# 없으면 엔진은 자동으로 mock LLM으로 돌아간다(테스트·오프라인 데모용).
ANTHROPIC_API_KEY=

# 설명 카드·챗봇 생성 모델
ROOKIE_LLM_MODEL=claude-sonnet-5

# LLM 어댑터 강제 선택: auto(기본) | claude | mock | fail
#   auto  — 키가 있으면 claude, 없으면 mock
#   fail  — 항상 실패시켜 폴백 경로를 검증할 때 사용
ROOKIE_LLM_BACKEND=auto

# 데이터 경로 (보통 건드릴 일 없음)
# ROOKIE_FIXTURE_DIR=./data/fixtures
# ROOKIE_SNAPSHOT_DIR=./data/snapshots
